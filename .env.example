# =============================================================
#  SERVIGO 2.0 - Environment configuration
#  Copy to .env.local for local dev. Set the same keys in the
#  Vercel dashboard under Settings > Environment Variables.
#  NEVER commit real values.
# =============================================================

# --- Database -------------------------------------------------
# Supabase > Project Settings > Database > Connection string
# Use the TRANSACTION POOLER string (port 6543) for serverless.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Direct connection (port 5432). Only used by the migration script.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Session signing -----------------------------------------
# Generate with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-48-byte-random-string"

# --- Admin bootstrap (replaces the old hardcoded admin) -------
# Only these emails may ever hold the Admin role. Comma separated.
ADMIN_EMAILS="you@example.com"

# One-time secret required to claim the first admin account at
# /admin/setup. Rotate or unset it once the admin exists.
# Generate with:  openssl rand -hex 32
ADMIN_SETUP_TOKEN="replace-me-with-a-random-hex-string"

# --- App ------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SERVIGO"
